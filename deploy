#!/usr/bin/env bash
# Trigger a deploy of hmsgit/singularity to hmsgit.github.io and watch it land.
#
#   ./deploy            trigger, then follow the run until it finishes
#   ./deploy --no-wait  trigger and return immediately
#
# Needs GITHUB_API_TOKEN in the environment, with workflow scope on this repo.

set -euo pipefail

REPO="hmsgit/hmsgit.github.io"
WORKFLOW="deploy.yml"
REF="master"
SITE="https://hmsgit.github.io"

wait_for_run=true
[[ "${1:-}" == "--no-wait" ]] && wait_for_run=false

if [[ -z "${GITHUB_API_TOKEN:-}" ]]; then
  echo "GITHUB_API_TOKEN is not set — export it and try again." >&2
  exit 1
fi

api() {
  curl -sS -H "Authorization: Bearer $GITHUB_API_TOKEN" \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" "$@"
}

# newest manually-triggered run right now, so we can tell ours apart from it
previous=$(api "https://api.github.com/repos/$REPO/actions/workflows/$WORKFLOW/runs?event=workflow_dispatch&per_page=1" |
  python3 -c "import json,sys; r=json.load(sys.stdin)['workflow_runs']; print(r[0]['id'] if r else 0)")

code=$(api -o /dev/null -w '%{http_code}' -X POST \
  "https://api.github.com/repos/$REPO/actions/workflows/$WORKFLOW/dispatches" \
  -d "{\"ref\":\"$REF\"}")

if [[ "$code" != "204" ]]; then
  echo "could not trigger the workflow (HTTP $code)" >&2
  exit 1
fi
echo "deploy triggered"

$wait_for_run || exit 0

# the run appears a moment after the dispatch returns
run_id=0
for _ in $(seq 1 20); do
  sleep 3
  run_id=$(api "https://api.github.com/repos/$REPO/actions/workflows/$WORKFLOW/runs?event=workflow_dispatch&per_page=1" |
    python3 -c "import json,sys; r=json.load(sys.stdin)['workflow_runs']; print(r[0]['id'] if r else 0)")
  [[ "$run_id" != "0" && "$run_id" != "$previous" ]] && break
done

if [[ "$run_id" == "0" || "$run_id" == "$previous" ]]; then
  echo "triggered, but the run did not show up — check the Actions tab" >&2
  exit 1
fi

echo "run: https://github.com/$REPO/actions/runs/$run_id"

status=""
while [[ "$status" != "completed" ]]; do
  sleep 10
  read -r status conclusion < <(api "https://api.github.com/repos/$REPO/actions/runs/$run_id" |
    python3 -c "import json,sys; d=json.load(sys.stdin); print(d['status'], d['conclusion'] or '-')")
  echo "  $status $conclusion"
done

if [[ "$conclusion" == "success" ]]; then
  echo "live: $SITE"
else
  echo "deploy $conclusion — see the run above" >&2
  exit 1
fi
